emacs/.emacs.d/**
!emacs/.emacs.d/init.el
!emacs/.emacs.d/custom.el
!emacs/.emacs.d/*.org
bin/.bin/rust-analyzer
git/.gitconfig_work
*.lock.json
.agent-shell
*.bak*

# Ignore everything under config/.config except tracked files.
# With --no-folding, stow creates real dirs — untracked app data must not leak in.
config/.config/**
!config/.config/ghostty/
!config/.config/ghostty/config
!config/.config/github-copilot/
!config/.config/github-copilot/versions.json
!config/.config/hypr/
# Hyprland: Lua-based config (post-migration). The Hyprland .conf files are gone.
!config/.config/hypr/hyprland.lua
!config/.config/hypr/monitors.lua
!config/.config/hypr/input.lua
!config/.config/hypr/bindings.lua
!config/.config/hypr/looknfeel.lua
!config/.config/hypr/autostart.lua
!config/.config/hypr/.luarc.json
# Companion daemons keep their own .conf (not affected by the Lua migration).
!config/.config/hypr/hypridle.conf
!config/.config/hypr/hyprlock.conf
!config/.config/hypr/hyprsunset.conf
!config/.config/hypr/xdph.conf
# Input-method (fcitx) env vars, formerly in hypr/envs.conf.
!config/.config/environment.d/
!config/.config/environment.d/fcitx.conf
!config/.config/i3/
!config/.config/i3/config
!config/.config/kitty/
!config/.config/kitty/kitty.conf
!config/.config/rofi/
!config/.config/rofi/config.rasi
!config/.config/rofi/slate.rasi
!config/.config/fcitx5/
!config/.config/fcitx5/config
!config/.config/fcitx5/profile
!config/.config/omarchy/
!config/.config/omarchy/hooks/
!config/.config/omarchy/hooks/post-update
!config/.config/systemd/
!config/.config/systemd/user/
!config/.config/systemd/user/org-zettel.service

scripts/__pycache__/