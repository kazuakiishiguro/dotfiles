[Unit]
Description=Agent Vault Maintenance Pipeline (Daily)
After=graphical-session.target org-zettel-agent.service

[Service]
Type=oneshot
WorkingDirectory=%h/org
TimeoutStartSec=30min
ExecStart=/usr/bin/python3 %h/org/agent-vault-tools/kb_run.py --vault-dir %h/org-agent --primary-vault-dir %h/org --llm codex --profile daily --llm-timeout 90

[Install]
WantedBy=default.target
