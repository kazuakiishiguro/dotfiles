# --- Shared shell config (sourced by .bashrc and .zshrc) ---

# --- Locale ---
if [[ -z "$LANG" ]]; then
    export LANG='en_US.UTF-8'
    export LC_ALL="en_US.UTF-8"
fi

# --- Editor ---
export EDITOR="emacsclient -t -a ''"
export VISUAL="$EDITOR"

# --- GPG ---
[ -t 0 ] && export GPG_TTY=$(tty)

# --- PATH ---
# Login shells and GUI Emacs must find Homebrew even with a system-only PATH.
# Prefer the selected installation, then the standard Apple Silicon/Intel roots.
if [[ "$(uname -s)" == Darwin ]]; then
    _dotfiles_brew=$(command -v brew 2>/dev/null) || _dotfiles_brew=
    if [[ -z "$_dotfiles_brew" ]]; then
        for _dotfiles_brew_candidate in /opt/homebrew/bin/brew /usr/local/bin/brew; do
            if [[ -x "$_dotfiles_brew_candidate" ]]; then
                _dotfiles_brew=$_dotfiles_brew_candidate
                break
            fi
        done
    fi
    # A login Zsh also reads .zshrc; do not prepend Homebrew twice.
    if [[ -n "$_dotfiles_brew" ]] &&
       { [[ -z "${HOMEBREW_PREFIX:-}" ]] || ! command -v brew >/dev/null 2>&1; }; then
        eval "$("$_dotfiles_brew" shellenv)"
    fi
    unset _dotfiles_brew _dotfiles_brew_candidate
fi

# .zprofile and .zshrc can both load this file; avoid accumulating PATH entries.
case ":$PATH:" in *":$HOME/.bin:"*) ;; *) PATH="$PATH:$HOME/.bin" ;; esac
case ":$PATH:" in *":/usr/local/sbin:"*) ;; *) PATH="/usr/local/sbin:$PATH" ;; esac
case ":$PATH:" in *":$HOME/.local/bin:"*) ;; *) PATH="$HOME/.local/bin:$PATH" ;; esac
export PATH

# Keep aliases and history out of noninteractive login/SSH commands.
[[ $- != *i* ]] && return 0

# --- History ---
HISTSIZE=1000
HISTFILESIZE=2000   # bash
if [ -n "${ZSH_VERSION:-}" ]; then
    HISTFILE=~/.zsh_history
    SAVEHIST=2000
fi

# --- Aliases ---
if [[ "$(uname -s)" == Darwin ]]; then
  alias l='ls -ltrG'
  alias ls='ls -G'
  alias la='ls -laG'
  alias ll='ls -lG'
else
  alias l='ls -ltr --color=auto'
  alias ls='ls --color=auto'
  alias la='ls -la --color=auto'
  alias ll='ls -l --color=auto'
fi
alias dockerrm='docker rm $(docker ps -aq)'
alias dockerrmi='docker rmi $(docker images -aq)'
alias dockerstop='docker stop $(docker ps -aq)'
alias dockerkill='docker kill $(docker ps -aq)'
alias emacsmin='emacs -nw --no-init-file --no-site-file'
alias emacs='emacs -nw'
